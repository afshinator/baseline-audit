{
  "schema": 1,
  "note": "Hand-maintained enrichments. sync-mappings.mjs merges these onto the e18e manifest. keep_if drives the usage analysis; rows without it are reported as check, never swap.",
  "packages": {
    "timeago.js": {
      "cluster": "intl",
      "replacement": "Intl.RelativeTimeFormat",
      "feature_ids": [
        "intl-relative-time-format"
      ],
      "keep_if": [],
      "polyfill": null,
      "note": "Library picked the unit for you; you write the arithmetic.",
      "partial": false
    },
    "pluralize": {
      "cluster": "intl",
      "replacement": "Intl.PluralRules",
      "feature_ids": [
        "intl-plural-rules"
      ],
      "keep_if": [],
      "polyfill": null,
      "note": "Singularisation of arbitrary words is not covered; plural selection is.",
      "partial": false
    },
    "numeral": {
      "cluster": "intl",
      "replacement": "Intl.NumberFormat",
      "feature_ids": [
        "intl"
      ],
      "keep_if": [
        "\\bnumeral\\.(locale|reset|zeroFormat|defaultFormat)"
      ],
      "polyfill": null,
      "note": "Intl.NumberFormat has no global locale/format switching API.",
      "partial": true
    },
    "humanize-duration": {
      "cluster": "intl",
      "replacement": "Intl.DurationFormat",
      "feature_ids": [
        "intl-duration-format"
      ],
      "keep_if": [],
      "polyfill": null,
      "note": "Rounding/largest-unit logic is yours to write.",
      "partial": false
    },
    "axios": {
      "cluster": "http",
      "replacement": "fetch + AbortSignal.timeout",
      "feature_ids": [
        "fetch",
        "abortsignal-timeout"
      ],
      "keep_if": [
        "interceptors",
        "onUploadProgress",
        "\\bupload\\b",
        "validateStatus",
        "axios\\.(create|all|spread|CancelToken|isCancel)",
        "responseType: *['\"](blob|arraybuffer)"
      ],
      "polyfill": null,
      "note": "HTTP errors resolve, not reject. Interceptors, retries, upload progress have no fetch equivalent.",
      "partial": false
    },
    "superagent": {
      "cluster": "http",
      "replacement": "fetch",
      "feature_ids": [
        "fetch"
      ],
      "keep_if": [
        "\\.attach\\(",
        "\\.on\\(['\"]progress",
        "\\.retry\\(",
        "\\.timeout\\("
      ],
      "polyfill": null,
      "note": "Upload progress and retries are real gaps.",
      "partial": false
    },
    "node-fetch": {
      "cluster": "http",
      "replacement": "global fetch",
      "feature_ids": [
        "fetch"
      ],
      "keep_if": [],
      "polyfill": null,
      "note": "Only if the code runs in a browser; keep for Node.",
      "partial": false
    },
    "cross-fetch": {
      "cluster": "http",
      "replacement": "global fetch",
